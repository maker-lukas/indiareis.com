---

---
<main class="not-found">
  <div class="content">
    <p>oops looks like I didn't draw this page</p>
    <img src="/assets/404.png" alt="Illustrated 404 page not found" class="error-art" />
  </div>
</main>

<style>
  @font-face {
    font-family: "Stefan";
    src: url("/fonts/Stefan.otf") format("opentype");
  }

  :global(body) {
    margin: 0;
    background: #f8f7f5;
    color: #1c1c1c;
  }

  .not-found {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
    background: #f8f7f5;
  }

  .content {
    display: grid;
    place-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  p {
    margin: 0;
    font-family: "Stefan", serif;
    font-size: clamp(1.1rem, 2vw, 2rem);
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .error-art {
    display: block;
    width: min(80vw, 500px);
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    transform: translateY(4px);
  }
</style>