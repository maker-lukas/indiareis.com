---
import type { Artwork } from '../data/artworks';
import Gallery from './Gallery.astro';

interface Props {
  artworks: Artwork[];
}

const { artworks } = Astro.props;
---

<Gallery
  images={artworks.map(({ image, thumb, width, height, alt, category, categoryLabel }) => ({
    src: image,
    thumb,
    width,
    height,
    alt,
    category,
    categoryLabel,
  }))}
/>