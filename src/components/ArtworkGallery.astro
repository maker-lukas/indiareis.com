---
import type { Artwork } from '../data/artworks';
import Gallery from './Gallery.astro';

interface Props {
  artworks: Artwork[];
}

const { artworks } = Astro.props;
---

<Gallery
  images={artworks.map(({ image, width, height, alt, category }) => ({
    src: image,
    width,
    height,
    alt,
    category,
  }))}
/>